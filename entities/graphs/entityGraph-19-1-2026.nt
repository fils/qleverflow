_:a6c8040d4f40d5c68960f3541191a28 <http://schema.org/value> "Redcar" .
<urn:gleaner.io:oih:medin:data:ba816701ae9ae03557d79f8bc8b1cd8175ee4aa0> <http://schema.org/additionalProperty> _:a6c8040d4f40d5c68960f3541191a28 .
_:a6c8040d4f40d5c68960f3541191a28 <http://schema.org/value> "Cleveland Borough Council" .
<urn:gleaner.io:oih:medin:data:ba816701ae9ae03557d79f8bc8b1cd8175ee4aa0> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/Dataset> .
_:a6c8040d4f40d5c68960f3541191a28 <http://schema.org/value> "Offshore Renewables Consents Unit" .
_:a6c8040d4f40d5c68960f3541191a28 <http://schema.org/name> "organizations" .
<urn:gleaner.io:oih:medin:data:ba816701ae9ae03557d79f8bc8b1cd8175ee4aa0> <http://schema.org/description> "This document within this series presents the decommissioning programme for TOW and is being submitted for approval in accordance with the Energy Act 2004 requirements. TOW will be decommissioned according to the lease conditions set out in the Crown Estate lease for this project.\r\nThe decommissioning programme is informed and supported by the Environmental Impact Assessment (EIA) for the TOW Project that was submitted to the Offshore Renewables Consents Unit which was part of the Department of Trade and Industry and to Redcar and Cleveland Borough Council in 2004.\r\nThis plan is to be reviewed and revised periodically throughout the lifecycle of the project to reflect changing circumstances and regulatory requirements, and to incorporate improvements in understanding of the marine environment and technology." .
_:a6c8040d4f40d5c68960f3541191a28 <http://schema.org/value> "Department of Trade and Industry" .
_:b6e4a50fd4997c145f94995a3cef253 <http://schema.org/name> "geospatial region" .
_:d4c293fcf4e34dd536ea30e10e36fee2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
_:d4c293fcf4e34dd536ea30e10e36fee2 <http://schema.org/name> "organizations" .
_:d4c293fcf4e34dd536ea30e10e36fee2 <http://schema.org/value> "Marine Aggregate Levy Sustainability Fund" .
_:b6e4a50fd4997c145f94995a3cef253 <http://schema.org/value> "Outer Thames" .
_:e171cbcd6b3daf86046dc7f25aa61e83 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
<urn:gleaner.io:oih:medin:data:ba7c08afdf70127e7f474438e0cffbe863e98413> <http://schema.org/description> "The Marine Aggregate Levy Sustainability Fund (MALSF) commissioned a series of regional surveys to develop understanding of submerged habitats and heritage in Britain.\r\n The aim of the Regional Environmental Characterisation (REC) surveys was to acquire data, of the highest quality and detail possible; to enable broad scale characterisation of the seabed habitats, their biological communities and potential historic environment assets within the regions.\r\n The Regional Environmental Characterisations (RECs) were conducted in the following areas. \r\n South Coast (2007 - 2010)\r\n Outer Thames (2007-2009)\r\n East Coast (2008 - 2011)\r\n Humber (2008 - 2011)" .
_:e171cbcd6b3daf86046dc7f25aa61e83 <http://schema.org/value> "Humber" .
<urn:gleaner.io:oih:medin:data:ba7c08afdf70127e7f474438e0cffbe863e98413> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/Dataset> .
_:b6e4a50fd4997c145f94995a3cef253 <http://schema.org/value> "South Coast" .
_:b6e4a50fd4997c145f94995a3cef253 <http://schema.org/value> "Britain" .
_:e171cbcd6b3daf86046dc7f25aa61e83 <http://schema.org/name> "marine regions" .
