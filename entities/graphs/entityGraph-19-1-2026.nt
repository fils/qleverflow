_:f2dd184af25befa658084c5e205cc67b <http://schema.org/value> "seabed habitats" .
<urn:gleaner.io:oih:medin:data:8714b72159ecc1a8b5fa2ee0f1ec255aa4f8e484> <http://schema.org/additionalProperty> _:f444cddb6ddafdc291f3a2360ff8610c .
