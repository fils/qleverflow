_:c302ec928de4a6ae8343d77f9429e27 <http://schema.org/name> "organizations" .
<urn:gleaner.io:oih:medin:data:29648ee7c60a38b638efa446064a882d902d3aed> <http://schema.org/additionalProperty> _:d9f0ab2bc598a1879a6bab36af7ad798 .
