_:f79c3151573d835f251b75c4833d6b3 <http://schema.org/value> "divers" .
<urn:gleaner.io:oih:medin:data:5a56a6feb7b6986a14c88f5038aa344c4bbd7f1f> <http://schema.org/additionalProperty> _:c3b0c2eed05a04c0dc5d71cdc8bd4161 .
