<urn:gleaner.io:oih:medin:data:03b5e5ba291076ac6fa2c66a175f03ed7fee4080> <http://schema.org/additionalProperty> _:d32e3aa78e8b9b5f119fc0e57b83f3d5 .
_:ea03ecb5caa2e77c29ce501e86a28ebd <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
