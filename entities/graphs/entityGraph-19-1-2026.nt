_:ffb4adfa93afe00a3542c1e10aee12e5 <http://schema.org/value> "fish" .
_:f5f62a8d6e0da6b69de47f596bea5f92 <http://schema.org/value> "fish" .
_:efa3fd4eba398abcc6e56f76850905b0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
