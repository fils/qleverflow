_:f5e47c2033623d45cc0ff6a889c7906b <http://schema.org/value> "Loch Moidart" .
_:f5e47c2033623d45cc0ff6a889c7906b <http://schema.org/value> "Loch Bracadale" .
_:ef6c3fa916cb65cf6aae199b50ed26d6 <http://schema.org/name> "measurements and facts" .
