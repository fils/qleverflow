<urn:gleaner.io:oih:medin:data:eb9c2717ded533d50926197d49974c8b943a0834> <http://schema.org/additionalProperty> _:b725c17c5f0522efce7e73bc0a40b2b1 .
_:cc7c23ae418e065977aa58259b2785f8 <http://schema.org/value> "Department of Oceanography" .
_:b725c17c5f0522efce7e73bc0a40b2b1 <http://schema.org/value> "Jensen" .
