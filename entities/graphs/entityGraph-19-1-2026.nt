<urn:gleaner.io:oih:medin:data:57e52f4ec04d5cb09c1eabbd7bdb9bfe4a131f7e> <http://schema.org/additionalProperty> _:f4033fa4825afe316ec7097dfdad8e65 .
_:f4033fa4825afe316ec7097dfdad8e65 <http://schema.org/value> "Galloper Wind Farm Limited" .
