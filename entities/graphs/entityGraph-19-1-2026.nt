<urn:gleaner.io:oih:medin:data:edd7202b05e90726da565d0bf80c8f79cc69e4f4> <http://schema.org/additionalProperty> _:a799eb6193dd82de86e78b050818774a .
_:a0abe3b0ea6ade1843c6477da48f3f55 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
