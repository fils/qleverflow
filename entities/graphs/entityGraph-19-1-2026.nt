_:d29b0480e080c6eb2bfea315ab0e546b <http://schema.org/value> "seabed level" .
<urn:gleaner.io:oih:medin:data:77f4e322d536de46ddb0ae7b1260a5754904bbbc> <http://schema.org/additionalProperty> _:c791d093e5b48ec37479a860c33a6927 .
_:d2d73d70b944f4815e8632904f4d3f2a <http://schema.org/value> "London Array Limited" .
<urn:gleaner.io:oih:medin:data:77d2655936de07091e7d22b437ce5ed1d6731f6d> <http://schema.org/description> "Fugro EMU Limited (Fugro EMU) was commissioned by Scira Offshore Energy Limited to conduct a\r\nbathymetry and sidescan sonar (SSS) survey of the Sheringham Shoal Offshore Wind Farm and export\r\ncables. The survey was required to fulfil Marine Management Organisation (MMO) requirements for\r\npost-construction monitoring." .
_:f1e0d95ec7b359deab383d377a051259 <http://schema.org/value> "sidescan sonar" .
<urn:gleaner.io:oih:medin:data:77d2655936de07091e7d22b437ce5ed1d6731f6d> <http://schema.org/additionalProperty> _:d5597ec510f7da3ce1f6b274cc57ae84 .
