_:fec5818c57d55188ef9e483523698aa9 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
_:e956a3a629b7786ed7c395f627cc7fbb <http://schema.org/value> "UK" .
_:e956a3a629b7786ed7c395f627cc7fbb <http://schema.org/name> "geospatial region" .
_:de5b367c54e89e824d73546fb2e3f009 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
