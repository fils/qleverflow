_:b991033874674f298c3d59767688e0a3 <http://schema.org/name> "measurements and facts" .
<urn:gleaner.io:oih:medin:data:fbccd6df72fd9c7757d2863818d332cf83a5cd52> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/Dataset> .
<urn:gleaner.io:oih:medin:data:fbccd6df72fd9c7757d2863818d332cf83a5cd52> <http://schema.org/additionalProperty> _:b991033874674f298c3d59767688e0a3 .
_:c89f794aebd852f68c6b4d8aa5626a60 <http://schema.org/value> "NW African coast" .
_:b991033874674f298c3d59767688e0a3 <http://schema.org/value> "hydrographic data profiles" .
_:c89f794aebd852f68c6b4d8aa5626a60 <http://schema.org/value> "North West African coast" .
<urn:gleaner.io:oih:medin:data:fbccd6df72fd9c7757d2863818d332cf83a5cd52> <http://schema.org/description> "This dataset comprises hydrographic data profiles, collected by a conductivity-temperature-depth (CTD) sensor package, during October - November 1981. It incorporates a coarse reconnaissance grid off the NW African coast from 19N to 24N, profiles on three current meter sites around 22N, 18W and high-resolution surveys of frontal features located between 22N and 23N. The data were collected by the University of Liverpool Department of Oceanography as part of a study of the upwelling area off the North West African coast." .
<urn:gleaner.io:oih:medin:data:fbccd6df72fd9c7757d2863818d332cf83a5cd52> <http://schema.org/additionalProperty> _:c89f794aebd852f68c6b4d8aa5626a60 .
