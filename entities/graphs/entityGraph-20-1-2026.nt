<urn:gleaner.io:oih:medin:data:a8508a40d1dbe3bfe330d5fda80f916fa2e66600> <http://schema.org/additionalProperty> _:aee8e544200fb821b70388db299520b8 .
_:b800bfbc35554d030801a1195da6dda4 <http://schema.org/name> "organizations" .
