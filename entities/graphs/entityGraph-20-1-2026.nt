_:d6c43a90973071e5192f95fe5eb62ef2 <http://schema.org/value> "rocky reef" .
<urn:gleaner.io:oih:medin:data:6e8f0a16c059e73ccf65bfed8550f6a1781670a4> <http://schema.org/additionalProperty> _:f0379f58bafc7003f8bd6c8aa749deef .
