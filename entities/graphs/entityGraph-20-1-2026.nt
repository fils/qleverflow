_:f44a4e792522675b6d8a4fffa1caeb97 <http://schema.org/value> "Sandwich tern" .
_:a703831ce60166335009804473606675 <http://schema.org/value> "abundance" .
_:f44a4e792522675b6d8a4fffa1caeb97 <http://schema.org/value> "razorbill" .
<urn:gleaner.io:oih:medin:data:3460cff0825998a28aa703b51c7a9f65c1eea12f> <http://schema.org/additionalProperty> _:f44a4e792522675b6d8a4fffa1caeb97 .
