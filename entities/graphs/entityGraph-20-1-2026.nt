_:f33ecc2db08e48f753b1ddd7a0d4d994 <http://schema.org/value> "common scoter Melanitta nigra" .
_:f33ecc2db08e48f753b1ddd7a0d4d994 <http://schema.org/value> "common tern Sterna hirundo" .
_:f33ecc2db08e48f753b1ddd7a0d4d994 <http://schema.org/value> "great cormorant Phalacrocorax carbo" .
