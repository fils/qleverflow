<urn:gleaner.io:oih:medin:data:34dfa8f00ff4ba5e7ab30b9abd870a7ea4f223d8> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/Dataset> .
_:dddeb819228f49a2fb7ed4a1834f33c4 <http://schema.org/name> "organizations" .
