<urn:gleaner.io:oih:medin:data:5eb4bd4660c6459ef0c66b0e6a11b090928cde59> <http://schema.org/additionalProperty> _:a7fde9c4ef1d2b915bc632c2d06a1961 .
_:a7fde9c4ef1d2b915bc632c2d06a1961 <http://schema.org/value> "Lidar - bathymetric survey" .
_:a7fde9c4ef1d2b915bc632c2d06a1961 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
<urn:gleaner.io:oih:medin:data:5eb4bd4660c6459ef0c66b0e6a11b090928cde59> <http://schema.org/description> "This processed bathymetric data set has been derived from a Lidar - bathymetric survey. The source data was collected, validated and processed for the purpose of Safety Of Life At Sea (SOLAS). The data set must not be used for navigation or to create products that could be used for navigation." .
_:bc33b2541f8b18c6e24c71510a65d352 <http://schema.org/value> "James Rennell Centre for Ocean Circulation" .
<urn:gleaner.io:oih:medin:data:5ea4a5dd2220aabe5d1a9f678f11c78733fa04aa> <http://schema.org/additionalProperty> _:b77c1d23982a576b1fa8a1347603afac .
