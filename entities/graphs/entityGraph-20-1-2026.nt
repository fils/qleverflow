<urn:gleaner.io:oih:medin:data:64e1314c0d75c64a187257d5844c6c5c7d22f3f6> <http://schema.org/additionalProperty> _:e4220d89fdb40b13f6b935804390ed19 .
_:e4220d89fdb40b13f6b935804390ed19 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
_:de0d3b51340d06737e7b67884dfd1a20 <http://schema.org/value> "Total E and P UK Plc" .
_:e4220d89fdb40b13f6b935804390ed19 <http://schema.org/name> "geospatial region" .
<urn:gleaner.io:oih:medin:data:64e1314c0d75c64a187257d5844c6c5c7d22f3f6> <http://schema.org/description> "On the instructions of Total E and P UK Plc (TEP UK), Fugro Survey Ltd performed a baseline environmental survey of the Laggan area for the proposed field development options in UKCS block 206/1, using the survey vessel Fugro Mercator. The aim of the survey was to map physical and biological features in the development areas and identify any potential habitats of conservation importance." .
_:c6e5624631c63ee765f71099a4dc0f17 <http://schema.org/name> "measurements and facts" .
_:d0fc076595874a905c4bc89d101636d6 <http://schema.org/value> "Stonehaven" .
<urn:gleaner.io:oih:medin:data:64d624b0afc17e80b87e5f6d5ae1a1221b398712> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/Dataset> .
_:c6e5624631c63ee765f71099a4dc0f17 <http://schema.org/value> "hydrographic data profiles" .
_:ff8d35e1c5b0e16734d6d305f35696e6 <http://schema.org/value> "Fisheries Research Services Aberdeen Marine Laboratory" .
<urn:gleaner.io:oih:medin:data:64d624b0afc17e80b87e5f6d5ae1a1221b398712> <http://schema.org/description> "The dataset comprises 48 hydrographic data profiles, collected by a conductivity-temperature-depth (CTD) sensor package, from across the North Sea area specifically along a transect offshore of Stonehaven and across the Wee Bankie/Marr Bank study area, during March and April of 2002. A complete list of all data parameters are described by the SeaDataNet Parameter Discovery Vocabulary (PDV) keywords assigned in this metadata record. The data were collected by the Fisheries Research Services Aberdeen Marine Laboratory." .
_:d0fc076595874a905c4bc89d101636d6 <http://schema.org/value> "North Sea area" .
_:d0fc076595874a905c4bc89d101636d6 <http://schema.org/name> "geospatial region" .
