_:acc789c482f743e86083150832b130f6 <http://schema.org/value> "Scotland" .
_:fdd54732dedce0d195ccaa2f3dd4903d <http://schema.org/value> "Marine Management Organisation" .
_:e7d05c46e5f5458033fea5308fc9eae6 <http://schema.org/name> "organizations" .
_:b3ab4f03ce648a23dd146260f3f245d <http://schema.org/value> "Celtic Sea" .
<urn:gleaner.io:oih:medin:data:e3380edd839178002630ae0ee028d8079b2d1734> <http://schema.org/additionalProperty> _:b3ab4f03ce648a23dd146260f3f245d .
