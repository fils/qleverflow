_:ee3bb23372d35e982eb025ba93da5d81 <http://schema.org/value> "Whitethorn" .
<urn:gleaner.io:oih:medin:data:2a9b259be749520a8586ab2fab3ad6e35a928765> <http://schema.org/additionalProperty> _:ee3bb23372d35e982eb025ba93da5d81 .
