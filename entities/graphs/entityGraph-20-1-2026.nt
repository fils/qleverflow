_:a43a52e4d04312b7102562234e28b8c <http://schema.org/value> "AMAP2" .
<urn:gleaner.io:oih:medin:data:c886f6cb62c824db8fc544df104c1ddd8f908d5a> <http://schema.org/additionalProperty> _:a5b9b3598b71454c4306ff825b940eed .
