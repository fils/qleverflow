_:d706149acc6451ba9273d7b0dae41b16 <http://schema.org/name> "conservation efforts" .
<urn:gleaner.io:oih:medin:data:5b74f3d5eba8ebe296e194677f9f2cd4eb5c6211> <http://schema.org/additionalProperty> _:d1b573b3253f2c5819d995460a7269b9 .
<urn:gleaner.io:oih:medin:data:5b74f3d5eba8ebe296e194677f9f2cd4eb5c6211> <http://schema.org/additionalProperty> _:ba21cc22ea023eeede8d159447f35316 .
