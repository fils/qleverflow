<urn:gleaner.io:oih:medin:data:18551e4d4229cbd209ecb270081af915eb6c1c69> <http://schema.org/additionalProperty> _:a4aee8f2acd0a8cdd7d3d8ae0522a992 .
_:b9849d18073d334144ed8a387c796c50 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
