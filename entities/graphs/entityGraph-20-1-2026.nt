_:a831a970b03601b1ccb0f2db783d317b <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
_:ff118332ec47d9feb088d7a5a4a608c1 <http://schema.org/value> "North Sea area" .
<urn:gleaner.io:oih:medin:data:d032bf7ad79a5350b541fc08a39596fab514046a> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/Dataset> .
_:bb160b8e907d3c22b6c73750ca944e36 <http://schema.org/name> "geospatial region" .
<urn:gleaner.io:oih:medin:data:d032bf7ad79a5350b541fc08a39596fab514046a> <http://schema.org/description> "A data set of a grab survey which was conducted to assess the sediment classification of Southannan Sands, a large mudflat on the west coast of Scotland." .
_:c8a0c3e15437112421cd989f1212a046 <http://schema.org/value> "grab survey" .
<urn:gleaner.io:oih:medin:data:d032bf7ad79a5350b541fc08a39596fab514046a> <http://schema.org/additionalProperty> _:bb160b8e907d3c22b6c73750ca944e36 .
