_:a88e5447559b24368068ed0347ae8d0b <http://schema.org/value> "Lundy" .
<urn:gleaner.io:oih:medin:data:2a771a953261ecfb46798b23c1092c35e8b48356> <http://schema.org/additionalProperty> _:e71de5f7ff8d1fdecc71e954cf0f16c6 .
