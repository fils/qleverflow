<urn:gleaner.io:oih:medin:data:22b9be127c904edfab6452e31590117c054eb8b5> <http://schema.org/additionalProperty> _:f834aba14289d3bd4fa5c10b5f6b1f2 .
_:fe4c4735bde1925de9fcdd29b6bc8804 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/PropertyValue> .
