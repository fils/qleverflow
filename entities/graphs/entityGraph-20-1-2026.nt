<urn:gleaner.io:oih:medin:data:94238ab415ae29b2ae14aaa4cca497b6c9fdf38c> <http://schema.org/additionalProperty> _:cc3057c45d4b3683e14f4f1a0f62aa5a .
<urn:gleaner.io:oih:medin:data:94238ab415ae29b2ae14aaa4cca497b6c9fdf38c> <http://schema.org/additionalProperty> _:f7b7acaebc734a7e72efa3f5ad449f17 .
